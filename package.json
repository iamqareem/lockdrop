{
  "name": "lockdrop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Peer-to-peer escrow for selling file and link access on Polygon PoS. Vanilla JavaScript throughout \u2014 no build step, no transpiler.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "deploy": "wrangler pages deploy public",
    "lint": "node scripts/lint.mjs",
    "check": "node scripts/check-abi.mjs && node scripts/check-contract.mjs && node scripts/check-categories.js && node scripts/check-frontend.mjs && node scripts/check-kb.mjs && node scripts/check-turso-read.mjs",
    "contract:build": "hardhat compile --build-profile production && node scripts/build-contract-artifact.mjs",
    "contract:test": "hardhat test nodejs",
    "contract:deploy:amoy": "hardhat run scripts/deploy-contract.js --network amoy",
    "contract:deploy:polygon": "hardhat run scripts/deploy-contract.js --network polygon",
    "test": "node --test tests/*.test.js",
    "schema": "turso db shell lockdrop < schema.sql",
    "kb:publish": "node scripts/publish-kb.mjs",
    "kb:catalog": "node scripts/catalog.mjs",
    "kb:build": "node scripts/build-kb.mjs",
    "kb:sync": "node scripts/sync-manifest.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "wrangler": "^4.162.0"
  }
}
