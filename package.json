{
  "name": "lockdrop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Peer-to-peer escrow for selling file and link access on Polygon PoS, backed by Turso SQLite and Cloudflare Pages Functions.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "deploy": "wrangler pages deploy public",
    "lint": "tsc --noEmit",
    "check": "node scripts/check-abi.mjs && node scripts/check-contract.mjs && tsx scripts/check-categories.ts",
    "contract:build": "hardhat compile --build-profile production && node scripts/build-contract-artifact.mjs",
    "contract:test": "hardhat test nodejs",
    "contract:deploy:amoy": "hardhat run scripts/deploy-contract.ts --network amoy",
    "contract:deploy:polygon": "hardhat run scripts/deploy-contract.ts --network polygon",
    "test": "node --test --import tsx tests/*.test.ts",
    "schema": "turso db shell lockdrop < schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.6",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "solc": "^0.8.38",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
