{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "@nomicfoundation/hardhat-ethers/types"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "functions/**/*.ts",
    "functions/**/*.d.ts",
    "tests/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "hardhat.config.ts"
  ],
  "exclude": ["node_modules", "dist", "public", ".hardhat"]
}
