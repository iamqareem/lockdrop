# Turso libSQL HTTP URL & token (used directly by the SPA via @libsql/client/web)
VITE_TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
VITE_TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# Deployed PolygonEscrow.sol contract address on Polygon PoS (Chain ID 137, 3% fee)
VITE_POLYGON_ESCROW_ADDRESS="0xYOUR_DEPLOYED_POLYGON_ESCROW_ADDRESS"

# OpenRouter free-tier AI key for lightweight link safety judgement
VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
VITE_OPENROUTER_MODEL="openrouter/free"

# Rewarded Ad & Incentive Monetization (optional; zero-cost user unlocks)
VITE_ADSGRAM_BLOCK_ID="YOUR_ADSGRAM_BLOCK_ID"
VITE_MONETAG_DIRECT_LINK="https://your-monetag-direct-link.example"
